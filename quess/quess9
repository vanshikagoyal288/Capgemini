public class Main
{
    public static String anss(String a){
        char[] c=a.toCharArray();
        String word="";
        for(int i=0;i<c.length;i++){
            char ch = (char)((a.charAt(i) - 'a' + 3) % 26 + 'a');
            word = word + ch;
        }
        return word;
    }
	public static void main(String[] args) {
	    String a="nrfzh";
		System.out.println(anss(a));
	}
}