public class Main
{
    public static int anss(int arr[],int n){
        int sum=0;
        int sum1=0;
        for(int i=1;i<=arr.length+1;i++){
            sum=sum+i;
        }
        for(int i=0;i<arr.length;i++)
        {
            sum1=sum1+arr[i];
        }
        return sum-sum1;
    }
	public static void main(String[] args) {
	    int arr[]={1,2,4,6,3,7,8};
	    int n=7;
		System.out.println(anss(arr,n));
	}
}