public class orgword {
   public static void main(String[] args) {
        String s = "11101111011111"; 
        int n = s.length();
        int co=0;
        StringBuilder sb=  new StringBuilder();
        for(int i=0;i<n;i++){
            char c =s.charAt(i);
            if(c!='0'){
                co++;
            }
            else{   
                sb.append((char)(co+'A'-1));
                co=0;
            }
        }
                if(s.charAt(n-1)!='0'){

                    sb.append((char)(co+'A'-1));
                }

        System.out.println(sb.toString());
   }
}