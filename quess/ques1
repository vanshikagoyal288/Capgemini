public class Main
{
    public static String wordd(String a,int b){
        String word="";
        for(int i=0;i<b;i++)
        {
           word=word+a; 
        }
        return word;
    }
	public static void main(String[] args) {
		String a="abc";
		int b=3;
		System.out.print(wordd(a,b));
	}
}