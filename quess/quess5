import java.util.*;
public class Main
{
    public static boolean ans(String a,String b){
        char c[]=a.toCharArray();
        char d[]=b.toCharArray();
        Arrays.sort(c);
        Arrays.sort(d);
        int flag=1;
        for(int i=0;i<c.length;i++)
        {
            if(c[i]!=d[i]){
                flag=0;
                break;
            }
        }
        if(flag==1){
            return true;
        }
        return false;
    }
	public static void main(String[] args) {
	    String a="build";
	    String b="dubli";
	    
		System.out.println(ans(a,b));
	}
}