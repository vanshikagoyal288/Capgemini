class CartItem {
    String itemName;
    double price;
    int quantity;

    CartItem(String itemName, double price) {
        this.itemName = itemName;
        this.price = price;
        this.quantity = 0;
    }

    void addItem(int qty) {
        quantity += qty;
    }

    void removeItem(int qty) {
        if (quantity >= qty) quantity -= qty;
    }

    void displayTotalCost() {
        System.out.println("Total Cost for " + itemName + ": " + (price * quantity));
    }
}

public class _10_SimulateShoppingCart {
    public static void main(String[] args) {
        CartItem item = new CartItem("Laptop", 1200.00);
        item.addItem(2);
        item.removeItem(1);
        item.displayTotalCost();
    }
}